---
---

<section class="relative w-full h-[520px] bg-slate-900 overflow-hidden font-sans">
  <!-- Background Image with Overlay -->
  <img 
    src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1600&q=80" 
    alt="NAMQUAN Hero Furniture" 
    class="absolute inset-0 w-full h-full object-cover object-center opacity-70"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent"></div>

  <!-- Hero Content Overlay -->
  <div class="relative max-w-7xl mx-auto h-full px-4 flex flex-col justify-end pb-16">
    <div class="max-w-2xl text-white">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight uppercase mb-4 drop-shadow-md">
        MỖI KHÔNG GIAN<br/>MỘT CÂU CHUYỆN RIÊNG
      </h1>
      <p class="text-base md:text-lg text-slate-100 italic leading-relaxed mb-6 font-light drop-shadow-sm">
        Kiến tạo không gian sống tinh tế với những giải pháp nội thất hiện đại, hài hòa giữa thẩm mỹ, công năng và cảm hứng sống.
      </p>
      <a 
        href="/products" 
        class="inline-flex items-center text-white font-medium text-base border-b-2 border-white pb-1 hover:text-emerald-300 hover:border-emerald-300 transition duration-300"
      >
        <span>Khám phá ngay</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
