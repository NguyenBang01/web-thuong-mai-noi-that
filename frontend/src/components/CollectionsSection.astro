---
const collections = [
  {
    title: "BST MODERN LIVING",
    image: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&q=80",
    link: "/products?collection=modern-living"
  },
  {
    title: "BST LUXURY",
    image: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=800&q=80",
    link: "/products?collection=luxury"
  },
  {
    title: "BST MINIMALIST",
    image: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=800&q=80",
    link: "/products?collection=minimalist"
  }
];
---

<section class="w-full bg-white py-14 font-sans">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {collections.map((item) => (
        <a 
          href={item.link} 
          class="group relative h-96 rounded-2xl overflow-hidden shadow-sm block"
        >
          <!-- Background Image -->
          <img 
            src={item.image} 
            alt={item.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-700"
          />
          <!-- Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-black/35 group-hover:bg-black/45 transition"></div>

          <!-- Title -->
          <div class="absolute inset-0 flex items-center justify-center p-6 text-center">
            <h3 class="text-white font-extrabold text-2xl md:text-3xl tracking-wider uppercase drop-shadow-md group-hover:scale-105 transition duration-300">
              {item.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
