          </div>

          <!-- CỘT 5: HƯƠNG THƠM, ĐÈN, THẢM -->
          <div class="space-y-5">
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">HƯƠNG THƠM</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=nen" class="hover:text-emerald-700 transition block">Nến</a></li>
                <li><a href="/products?type=tinh-dau" class="hover:text-emerald-700 transition block">Tinh dầu</a></li>
                <li><a href="/products?type=hoa-tinh-dau" class="hover:text-emerald-700 transition block">Hoa tinh dầu</a></li>
                <li><a href="/products?type=bo-huong-thom" class="hover:text-emerald-700 transition block">Bộ hương thơm</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">ĐÈN</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=den-ban" class="hover:text-emerald-700 transition block">Đèn bàn</a></li>
