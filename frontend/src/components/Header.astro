          </div>

          <!-- CỘT 6: TRANG TRÍ -->
          <div>
            <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">TRANG TRÍ</h4>
            <ul class="space-y-2">
              <li><a href="/products?type=chan-nen" class="hover:text-emerald-700 transition block">Chân nến</a></li>
              <li><a href="/products?type=binh-trang-tri" class="hover:text-emerald-700 transition block">Bình trang trí</a></li>
              <li><a href="/products?type=goi-trang-tri" class="hover:text-emerald-700 transition block">Gối trang trí</a></li>
              <li><a href="/products?type=khung-hinh" class="hover:text-emerald-700 transition block">Khung hình</a></li>
              <li><a href="/products?type=tranh" class="hover:text-emerald-700 transition block">Tranh</a></li>
              <li><a href="/products?type=guong" class="hover:text-emerald-700 transition block">Gương</a></li>
              <li><a href="/products?type=dong-ho" class="hover:text-emerald-700 transition block">Đồng hồ</a></li>
              <li><a href="/products?type=hoa-cay" class="hover:text-emerald-700 transition block">Hoa và cây</a></li>
              <li><a href="/products?type=tuong-trang-tri" class="hover:text-emerald-700 transition block">Tượng trang trí</a></li>
