---
---

<!-- Top Header Navigation -->
<header class="w-full bg-white font-sans sticky top-0 z-50 shadow-xs">
  <!-- Top Utility Bar -->
  <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center text-sm text-gray-700">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-1">
      <div class="text-2xl font-black tracking-wider text-slate-800 flex items-center">
        <span>KHÔNG GIAN</span>
        <span class="text-emerald-700 ml-1">MỚI</span>
        <svg class="w-6 h-6 text-emerald-500 ml-1 inline" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 8C8 10 59 16.5 18 22 12 18 10 12 17 8z"/>
        </svg>
      </div>
    </a>

    <!-- Top Right Action Icons -->
    <div class="flex items-center space-x-6 text-xs font-medium text-slate-700">
      <!-- User Profile (Click to Login) -->
      <a href="/?auth=login" class="flex flex-col items-center hover:text-emerald-700 transition">
        <div class="w-6 h-6 rounded-full border border-slate-400 flex items-center justify-center mb-0.5">
          <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <span>Đăng nhập</span>
      </a>

      <!-- Shopping Cart -->
      <a href="#" class="flex flex-col items-center hover:text-emerald-700 transition">
        <svg class="w-6 h-6 text-slate-700 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
        </svg>
        <span>Giỏ hàng</span>
      </a>

      <!-- Notifications -->
      <a href="#" class="flex flex-col items-center hover:text-emerald-700 transition">
        <svg class="w-6 h-6 text-slate-700 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span>Thông báo</span>
      </a>

      <!-- Support & Contact -->
      <a href="#" class="flex flex-col items-center hover:text-emerald-700 transition">
        <svg class="w-6 h-6 text-slate-700 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <span>Liên hệ và hỗ trợ</span>
      </a>

      <!-- Language Switcher -->
      <div class="flex items-center bg-emerald-600 rounded-full p-0.5 text-[11px] font-bold text-white shadow-xs">
        <span class="bg-emerald-600 px-2 py-0.5 rounded-full">VN</span>
        <span class="px-2 py-0.5 text-emerald-100 hover:text-white cursor-pointer">EN</span>
      </div>
    </div>
  </div>

  <!-- Sub Navigation Bar & Search Overlay -->
  <div class="border-t border-slate-100 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 py-2.5 flex justify-between items-center">
      <!-- Main Category Nav Links -->
      <nav class="flex items-center space-x-8 text-sm font-medium text-slate-800">
        <a href="/" class="hover:text-emerald-700 transition font-semibold">Trang chủ</a>

        <!-- Nút Sản phẩm kích hoạt Mega Menu khi BẤM -->
        <button 
          id="product-menu-btn" 
          type="button" 
          class="inline-flex items-center space-x-1.5 hover:text-emerald-700 transition focus:outline-none cursor-pointer py-1"
          aria-expanded="false"
        >
          <span>Sản phẩm</span>
          <svg id="product-menu-chevron" class="w-4 h-4 text-slate-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <a href="#" class="hover:text-emerald-700 transition">Bộ sưu tập</a>
        <a href="#" class="hover:text-emerald-700 transition">Dự án</a>
        <a href="#" class="hover:text-emerald-700 transition">Tin tức</a>
        <a href="/gioi-thieu" class="hover:text-emerald-700 transition">Liên hệ</a>
      </nav>

      <!-- Search Bar -->
      <div class="relative w-72">
        <input 
          type="text" 
          placeholder="Tìm sản phẩm..." 
          class="w-full bg-emerald-50/70 text-slate-800 placeholder-emerald-800/60 text-sm px-4 py-2 pl-9 rounded-full focus:outline-none focus:ring-2 focus:ring-emerald-500/50 border border-emerald-100"
        />
        <svg class="w-4 h-4 text-emerald-800 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
    </div>

    <!-- ==================== MEGA MENU SẢN PHẨM ==================== -->
    <div 
      id="product-mega-menu" 
      class="hidden absolute top-full left-0 w-full bg-white border-t border-slate-200 shadow-2xl z-50 animate-fadeIn"
    >
      <div class="max-w-7xl mx-auto px-6 py-8">
        <div class="grid grid-cols-7 gap-6 text-xs text-slate-600">

          <!-- CỘT 1: SOFA & GHẾ -->
          <div class="space-y-6">
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">SOFA</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=sofa-bang" class="hover:text-emerald-700 transition block">Sofa băng</a></li>
                <li><a href="/products?type=sofa-goc" class="hover:text-emerald-700 transition block">Sofa góc</a></li>
                <li><a href="/products?type=sofa-dien" class="hover:text-emerald-700 transition block">Sofa điện</a></li>
                <li><a href="/products?type=sofa-bed" class="hover:text-emerald-700 transition block">Sofa bed</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">GHẾ</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=armchair" class="hover:text-emerald-700 transition block">Armchair</a></li>
                <li><a href="/products?type=ghe-thu-gian" class="hover:text-emerald-700 transition block">Ghế thư giãn</a></li>
                <li><a href="/products?type=ghe-dai-don" class="hover:text-emerald-700 transition block">Ghế dài & đôn</a></li>
                <li><a href="/products?type=ghe-an" class="hover:text-emerald-700 transition block">Ghế ăn</a></li>
                <li><a href="/products?type=ghe-bar" class="hover:text-emerald-700 transition block">Ghế bar</a></li>
              </ul>
            </div>
          </div>

          <!-- CỘT 2: BÀN -->
          <div>
            <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">BÀN</h4>
            <ul class="space-y-2">
              <li><a href="/products?type=ban-an" class="hover:text-emerald-700 transition block">Bàn ăn</a></li>
              <li><a href="/products?type=ban-ben" class="hover:text-emerald-700 transition block">Bàn bên</a></li>
              <li><a href="/products?type=ban-nuoc" class="hover:text-emerald-700 transition block">Bàn nước</a></li>
              <li><a href="/products?type=ban-console" class="hover:text-emerald-700 transition block">Bàn console</a></li>
              <li><a href="/products?type=ban-lam-viec" class="hover:text-emerald-700 transition block">Bàn làm việc</a></li>
