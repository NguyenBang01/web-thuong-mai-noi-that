            </ul>
          </div>

          <!-- CỘT 7: BANNER KHUYẾN MÃI / BỘ SƯU TẬP -->
          <div class="bg-slate-50 rounded-2xl p-4 flex flex-col justify-between border border-slate-100">
            <div>
              <div class="rounded-xl overflow-hidden mb-3 aspect-4/3 bg-slate-200">
                <img 
                  src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&q=80" 
                  alt="Không Gian Mới - Bộ sưu tập" 
                  class="w-full h-full object-cover hover:scale-105 transition duration-500"
                />
              </div>
              <div class="flex items-center space-x-1.5 text-slate-800 font-bold text-xs mb-1.5">
                <span class="text-sm">🛋️</span>
                <span>Nội thất đẹp cho không gian sống</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-relaxed mb-4">
                Khám phá bộ sưu tập nội thất mới nhất từ Không Gian Mới.
              </p>
            </div>

            <a 
              href="/products" 
              class="w-full bg-slate-900 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-full text-center transition duration-200 inline-block text-xs"
            >
              Xem ngay
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMegaMenu() {
    const toggleBtn = document.getElementById('product-menu-btn');
    const megaMenu = document.getElementById('product-mega-menu');
    const menuChevron = document.getElementById('product-menu-chevron');

    if (!toggleBtn || !megaMenu) return;

    function openMenu() {
      megaMenu?.classList.remove('hidden');
      menuChevron?.classList.add('rotate-180');
      toggleBtn?.classList.add('text-emerald-700', 'font-semibold');
      toggleBtn?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      megaMenu?.classList.add('hidden');
      menuChevron?.classList.remove('rotate-180');
      toggleBtn?.classList.remove('text-emerald-700', 'font-semibold');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }

    // Toggle menu on click
    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isHidden = megaMenu.classList.contains('hidden');
      if (isHidden) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!megaMenu.contains(target) && !toggleBtn.contains(target)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });
  }

  // Run on initial load and view transitions
  setupMegaMenu();
  document.addEventListener('astro:page-load', setupMegaMenu);
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.2s ease-out forwards;
  }
</style>
