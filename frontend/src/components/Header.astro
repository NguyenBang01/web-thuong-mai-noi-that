            <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">TỦ & KỆ</h4>
            <ul class="space-y-2">
              <li><a href="/products?type=tu-tivi" class="hover:text-emerald-700 transition block">Tủ tivi</a></li>
              <li><a href="/products?type=tu-giay" class="hover:text-emerald-700 transition block">Tủ giày</a></li>
              <li><a href="/products?type=tu-ly" class="hover:text-emerald-700 transition block">Tủ ly</a></li>
              <li><a href="/products?type=tu-ao" class="hover:text-emerald-700 transition block">Tủ áo</a></li>
              <li><a href="/products?type=tu-cabinet" class="hover:text-emerald-700 transition block">Tủ cabinet</a></li>
              <li><a href="/products?type=tu-ruou" class="hover:text-emerald-700 transition block">Tủ rượu</a></li>
              <li><a href="/products?type=tu-hoc-keo" class="hover:text-emerald-700 transition block">Tủ hộc kéo</a></li>
              <li><a href="/products?type=tu-dau-giuong" class="hover:text-emerald-700 transition block">Tủ đầu giường</a></li>
              <li><a href="/products?type=ke-treo-tuong" class="hover:text-emerald-700 transition block">Kệ treo tường</a></li>
              <li><a href="/products?type=ke-trung-bay" class="hover:text-emerald-700 transition block">Kệ trưng bày</a></li>
            </ul>
          </div>

          <!-- CỘT 4: GIƯỜNG & NỆM, NGOẠI THẤT, BẾP -->
          <div class="space-y-5">
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">GIƯỜNG & NỆM</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=giuong" class="hover:text-emerald-700 transition block">Giường</a></li>
                <li><a href="/products?type=nem" class="hover:text-emerald-700 transition block">Nệm</a></li>
                <li><a href="/products?type=chan-ga-goi" class="hover:text-emerald-700 transition block">Chăn ga gối</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">NGOẠI THẤT</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=ghe-ngoai-troi" class="hover:text-emerald-700 transition block">Ghế ngoài trời</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 uppercase tracking-wider text-xs mb-3">BẾP</h4>
              <ul class="space-y-2">
                <li><a href="/products?type=tu-bep" class="hover:text-emerald-700 transition block">Tủ bếp</a></li>
                <li><a href="/products?type=thiet-bi-bep" class="hover:text-emerald-700 transition block">Thiết bị bếp</a></li>
                <li><a href="/products?type=dung-cu-bep" class="hover:text-emerald-700 transition block">Dụng cụ bếp</a></li>
