---
const categories = [
  { name: 'Sofa', slug: 'sofa', image: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=500' },
  { name: 'Ghế', slug: 'ghe', image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=500', active: true },
  { name: 'Bàn & Tủ', slug: 'ban-tu', image: 'https://images.unsplash.com/photo-1615066390971-03e4e1c36ddf?w=500' },
  { name: 'Giường', slug: 'giuong', image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=500' },
  { name: 'Ngoài trời', slug: 'nguoi-troi', image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=500' },
  { name: 'Văn phòng', slug: 'van-phong', image: 'https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=500' },
  { name: 'Trang trí', slug: 'trang-tri', image: 'https://images.unsplash.com/photo-1534349762230-e0cadf78f5da?w=500' },
];
---

<section class="w-full bg-emerald-50/30 py-10 font-sans">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-4">
      {categories.map((cat) => (
        <a 
          href={`/products?category=${cat.slug}`}
          class={`group relative h-64 rounded-2xl overflow-hidden shadow-xs border-2 transition duration-300 block ${
            cat.active ? 'border-emerald-500 shadow-md ring-2 ring-emerald-400/30' : 'border-transparent hover:border-emerald-300'
          }`}
        >
          <!-- Category Background Image -->
          <img 
            src={cat.image} 
            alt={cat.name} 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
          <!-- Dark Overlay for Readability -->
          <div class="absolute inset-0 bg-black/25 group-hover:bg-black/35 transition"></div>
          
          <!-- Category Title Overlay -->
          <div class="absolute inset-0 flex items-center justify-center">
            <h3 class="text-white font-bold text-lg tracking-wide drop-shadow-md group-hover:scale-110 transition duration-300">
              {cat.name}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
