---
interface Product {
  id: number;
  name: string;
  slug: string;
  price: number;
  sale_price: number;
  image: string;
  category?: { name: string };
}

const { products = [] } = Astro.props as { products: Product[] };

const displayProducts = [
  {
    id: 1,
    name: "Sofa Băng Bọc Da KHÔNG GIAN MỚI",
    slug: "sofa-bang-boc-da-khonggianmoi",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 2,
    name: "Bình Hoa Decor Ngọc Bích",
    slug: "binh-hoa-decor-ngoc-bich",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1578500494198-246f612d3b3d?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 3,
    name: "Ghế Armchair Pastel Blue",
    slug: "ghe-armchair-pastel-blue",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 4,
    name: "Ghế Mây Đan Treo Ban Công",
    slug: "ghe-may-dan-treo",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 5,
    name: "Bàn Trang Điểm Gỗ Sồi Nga",
    slug: "ban-trang-diem-go-soi",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1615066390971-03e4e1c36ddf?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 6,
    name: "Ghế Thư Giãn Đơn Cream",
    slug: "ghe-thu-gian-don-cream",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1580481072645-022f9a6d83d0?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 7,
    name: "Sofa Vải Nỉ Bắc Âu",
    slug: "sofa-vai-ni-bac-au",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1493663284031-b7e3aefcae8e?w=600",
    category: "Ghế Sofa"
  },
  {
    id: 8,
    name: "Ghế Armchair Hồng Classic",
    slug: "ghe-armchair-hong-classic",
    price: 11000000,
    image: "https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?w=600",
    category: "Ghế Sofa"
  }
];
---

<section class="w-full bg-gradient-to-b from-emerald-100/70 via-emerald-100/50 to-white py-16 font-sans">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Section Header Title -->
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold text-emerald-700 tracking-tight uppercase leading-snug">
        MỖI KHÔNG GIAN MỘT CÂU CHUYỆN<br />
        <span class="text-emerald-800">PHÒNG TRƯNG BÀY KHÔNG GIAN MỚI</span>
      </h2>
    </div>

    <!-- Room Category Tabs -->
    <div class="bg-emerald-50/80 rounded-2xl p-2 max-w-4xl mx-auto mb-6 flex justify-between items-center overflow-x-auto">
      <button class="bg-white text-emerald-800 font-bold px-6 py-2.5 rounded-xl shadow-2xs border-b-2 border-emerald-600 text-sm whitespace-nowrap">
        Tất cả
      </button>
      <button class="text-slate-700 hover:text-emerald-800 font-medium px-5 py-2 text-sm whitespace-nowrap">
        Phòng khách
      </button>
      <button class="text-slate-700 hover:text-emerald-800 font-medium px-5 py-2 text-sm whitespace-nowrap">
        Phòng ngủ
      </button>
      <button class="text-slate-700 hover:text-emerald-800 font-medium px-5 py-2 text-sm whitespace-nowrap">
        Bếp
      </button>
      <button class="text-slate-700 hover:text-emerald-800 font-medium px-5 py-2 text-sm whitespace-nowrap">
        Văn phòng
      </button>
      <button class="text-slate-700 hover:text-emerald-800 font-medium px-5 py-2 text-sm whitespace-nowrap">
        Decor
      </button>
    </div>

    <!-- Filters Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-10">
      <button class="flex items-center space-x-2 bg-amber-50 text-amber-600 border border-amber-400 px-4 py-2 rounded-xl text-xs font-semibold shadow-2xs">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
        </svg>
        <span>Bộ lọc</span>
      </button>

      <div class="flex flex-wrap items-center gap-2">
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Loại sản phẩm</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Giá</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Phong cách</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Màu sắc</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Chất liệu</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Kích thước</button>
        <button class="bg-white text-slate-700 border border-slate-200 px-3.5 py-1.5 rounded-lg text-xs font-medium hover:border-emerald-400">Thương hiệu</button>
      </div>
    </div>

    <!-- Product Grid (8 Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {displayProducts.map((item) => (
        <div class="bg-white rounded-2xl p-4 shadow-xs hover:shadow-md transition duration-300 border border-slate-100 flex flex-col justify-between relative group">
          <!-- Heart & Cart -->
          <div class="absolute top-6 right-6 z-10 flex flex-col space-y-2">
            <button class="w-8 h-8 rounded-full bg-white shadow-md border border-slate-100 flex items-center justify-center text-slate-400 hover:text-red-500 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </button>
            <button class="w-8 h-8 rounded-full bg-white shadow-md border border-slate-100 flex items-center justify-center text-slate-600 hover:text-emerald-700 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
              </svg>
            </button>
          </div>

          <!-- Image -->
          <a href={`/products/${item.slug}`} class="block h-52 overflow-hidden rounded-xl mb-4 bg-slate-50">
            <img 
              src={item.image} 
              alt={item.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          </a>

          <!-- Details & Price -->
          <div>
            <span class="text-xs text-slate-500 block mb-1 font-medium">{item.category}</span>
            <div class="flex justify-between items-baseline">
              <div class="flex items-center space-x-1">
                <span class="w-3 h-3 rounded-full bg-emerald-100 border-2 border-emerald-500 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-rose-200 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-stone-200 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-slate-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-slate-900 inline-block"></span>
              </div>
              <span class="text-base font-bold text-emerald-700">
                {item.price.toLocaleString('vi-VN')} <span class="text-[10px] font-normal text-emerald-600">VND</span>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Center See All Button -->
    <div class="text-center">
      <a 
        href="/products" 
        class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm px-10 py-3 rounded-xl shadow-md transition duration-300"
      >
        Xem tất cả
      </a>
    </div>

  </div>
</section>
