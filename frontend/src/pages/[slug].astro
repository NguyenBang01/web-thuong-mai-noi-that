---
import '../styles/global.css'; // 1. THÊM DÒNG NÀY (sửa đường dẫn nếu file css của bạn ở chỗ khác)

// Chuyển sang chế độ SSR để đọc param động lúc request
export const prerender = false;

const { slug } = Astro.params;

let pageData = null;
try {
  const res = await fetch(`http://localhost:8080/api/pages/${slug}`);
  if (res.ok) {
    pageData = await res.json();
  }
} catch (error) {
  console.error("Lỗi khi tải trang:", error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageData ? pageData.title : 'Trang không tồn tại'} - NAMQUAN FURNITURE</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    
    <!-- Navbar -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold tracking-wider text-amber-900">NAMQUAN FURNITURE</a>
        <nav class="space-x-6 text-sm font-medium">
          <a href="/" class="hover:text-amber-800">Trang chủ</a>
          <a href="/gioi-thieu" class="text-amber-800">Giới thiệu</a>
        </nav>
      </div>
    </header>

    {!pageData ? (
      <main class="max-w-4xl mx-auto px-4 py-16 text-center">
        <h1 class="text-3xl font-bold text-red-600 mb-2">404 - Không tìm thấy trang</h1>
        <p class="text-gray-500 text-sm mb-6">Trang bạn đang tìm kiếm không tồn tại hoặc Backend API chưa khởi chạy.</p>
        <a href="/" class="bg-amber-900 hover:bg-amber-800 text-white px-4 py-2 rounded text-sm transition inline-block">
          Quay lại trang chủ
        </a>
      </main>
    ) : (
      <>
        <!-- Page Content Header -->
        <section class="bg-amber-900 text-white py-12 text-center">
          <h1 class="text-3xl font-light">{pageData.title}</h1>
        </section>

        <!-- Dynamic HTML Content Rendering -->
        <main class="max-w-4xl mx-auto px-4 py-12">
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-8">
            <!-- 2. THÊM class="prose max-w-none" VÀO DÒNG DƯỚI ĐÂY -->
            <div set:html={pageData.html_content} class="prose max-w-none" />
          </div>
        </main>
      </>
    )}
        
  </body>
</html>