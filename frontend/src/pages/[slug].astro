---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = false;

const { slug } = Astro.params;

let pageData = null;
try {
  const res = await fetch(`http://localhost:8080/api/pages/${slug}`);
  if (res.ok) {
    pageData = await res.json();
  }
} catch (error) {
  console.error("Lỗi khi tải trang:", error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageData ? pageData.title : 'Trang không tồn tại'} - KHÔNG GIAN MỚI</title>
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
    
    <div>
      <Header />

      {!pageData ? (
        <main class="max-w-4xl mx-auto px-4 py-16 text-center">
          <h1 class="text-3xl font-bold text-red-600 mb-2">404 - Không tìm thấy trang</h1>
          <p class="text-slate-500 text-sm mb-6">Trang bạn đang tìm kiếm không tồn tại hoặc Backend API chưa khởi chạy.</p>
          <a href="/" class="bg-emerald-800 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm transition inline-block font-medium">
            Quay lại trang chủ
          </a>
        </main>
      ) : (
        <>
          <!-- Page Content Header -->
          <section class="bg-emerald-900 text-white py-14 text-center">
            <h1 class="text-3xl font-bold tracking-tight">{pageData.title}</h1>
          </section>

          <!-- Dynamic HTML Content Rendering -->
          <main class="max-w-4xl mx-auto px-4 py-12">
            <div class="bg-white rounded-2xl shadow-xs border border-emerald-100 p-8 md:p-12">
              <div set:html={pageData.html_content} class="prose max-w-none text-slate-700" />
            </div>
          </main>
        </>
      )}
    </div>

    <Footer />
  </body>
</html>