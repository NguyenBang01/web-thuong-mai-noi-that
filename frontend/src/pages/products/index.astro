---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Đọc query params: ?type=ban-an
const typeParam = Astro.url.searchParams.get('type') || '';
const categoryParam = Astro.url.searchParams.get('category') || '';
const searchParam = Astro.url.searchParams.get('search') || '';

// Bản đồ tên hiển thị cho các loại sản phẩm
const typeTitles: Record<string, string> = {
  'ban-an': 'Bàn Ăn',
  'ban-ben': 'Bàn Bên',
  'ban-nuoc': 'Bàn Nước',
  'ban-console': 'Bàn Console',
  'ban-lam-viec': 'Bàn Làm Việc',
  'ban-trang-diem': 'Bàn Trang Điểm',
  'sofa-bang': 'Sofa Băng',
  'sofa-goc': 'Sofa Góc',
  'sofa-dien': 'Sofa Điện',
  'sofa-bed': 'Sofa Bed',
  'armchair': 'Ghế Armchair',
  'ghe-thu-gian': 'Ghế Thư Giãn',
  'ghe-an': 'Ghế Ăn',
  'tu-tivi': 'Tủ Tivi',
  'tu-ao': 'Tủ Áo',
  'giuong': 'Giường Ngủ',
  'den-ban': 'Đèn Bàn',
  'binh-trang-tri': 'Bình Trang Trí',
};

const pageTitle = typeParam ? (typeTitles[typeParam] || typeParam.toUpperCase()) : 'Tất cả sản phẩm';

// Gọi API Backend lấy danh sách sản phẩm theo type
let products: any[] = [];
try {
  let apiUrl = 'http://localhost:8080/api/products';
  const queryParams = new URLSearchParams();
  if (typeParam) queryParams.set('type', typeParam);
  if (categoryParam) queryParams.set('category', categoryParam);
  if (queryParams.toString()) {
    apiUrl += `?${queryParams.toString()}`;
  }

  const res = await fetch(apiUrl);
  if (res.ok) {
    products = await res.json();
  }
} catch (error) {
  console.error('Lỗi khi tải sản phẩm:', error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} - KHÔNG GIAN MỚI</title>
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
    <div>
      <Header />

      <!-- Breadcrumbs & Banner -->
      <section class="bg-emerald-900 text-white py-10">
        <div class="max-w-7xl mx-auto px-4">
          <nav class="text-xs text-emerald-200 mb-2 flex items-center space-x-2">
            <a href="/" class="hover:underline">Trang chủ</a>
            <span>/</span>
            <a href="/products" class="hover:underline">Sản phẩm</a>
            {typeParam && (
              <>
                <span>/</span>
                <span class="text-white font-medium">{pageTitle}</span>
              </>
            )}
          </nav>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold tracking-tight uppercase">{pageTitle}</h1>
              <p class="text-emerald-100 text-sm mt-1">
                Khám phá bộ sưu tập {pageTitle.toLowerCase()} thiết kế tinh tế, chất lượng cao từ Không Gian Mới.
              </p>
            </div>
            
            <!-- Nút Mở Modal Thêm Sản Phẩm Mới -->
            <button 
              id="open-add-product-btn" 
              class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-4 py-2.5 rounded-xl text-xs flex items-center space-x-1.5 shadow-sm transition self-start md:self-auto cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span>+ Thêm sản phẩm mới</span>
            </button>
          </div>
        </div>
      </section>

      <!-- Main Content -->
      <main class="max-w-7xl mx-auto px-4 py-10">
        
        <!-- Filter Tags Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8 bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-bold text-slate-700 mr-2">Danh mục bàn:</span>
            <a href="/products?type=ban-an" class={`px-3 py-1.5 rounded-lg border transition ${typeParam === 'ban-an' ? 'bg-emerald-800 text-white border-emerald-800 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-emerald-600'}`}>Bàn ăn</a>
            <a href="/products?type=ban-ben" class={`px-3 py-1.5 rounded-lg border transition ${typeParam === 'ban-ben' ? 'bg-emerald-800 text-white border-emerald-800 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-emerald-600'}`}>Bàn bên</a>
            <a href="/products?type=ban-nuoc" class={`px-3 py-1.5 rounded-lg border transition ${typeParam === 'ban-nuoc' ? 'bg-emerald-800 text-white border-emerald-800 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-emerald-600'}`}>Bàn nước</a>
            <a href="/products?type=ban-lam-viec" class={`px-3 py-1.5 rounded-lg border transition ${typeParam === 'ban-lam-viec' ? 'bg-emerald-800 text-white border-emerald-800 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-emerald-600'}`}>Bàn làm việc</a>
            <a href="/products" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100">Xem tất cả</a>
          </div>

          <div class="text-xs text-slate-500">
            Tìm thấy <strong class="text-emerald-800">{products.length}</strong> sản phẩm
          </div>
        </div>

        <!-- Product Grid -->
        {products.length === 0 ? (
          <div class="bg-white rounded-3xl p-16 text-center border border-slate-200 shadow-xs">
            <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
              🛋️
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-2">Chưa có sản phẩm nào thuộc mục "{pageTitle}"</h3>
            <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">
              Bạn có thể bấm nút "Thêm sản phẩm mới" bên trên để tạo dữ liệu cho mục này ngay lập tức.
            </p>
            <button 
              onclick="document.getElementById('open-add-product-btn')?.click()"
              class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-semibold px-6 py-2.5 rounded-xl transition"
            >
              Nhập thông tin sản phẩm {pageTitle}
            </button>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {products.map((item) => (
              <div class="bg-white rounded-2xl p-4 shadow-xs hover:shadow-md transition duration-300 border border-slate-100 flex flex-col justify-between group">
                <div>
                  <a href={`/products/${item.slug}`} class="block h-56 overflow-hidden rounded-xl mb-4 bg-slate-50">
                    <img 
                      src={item.image || 'https://images.unsplash.com/photo-1615066390971-03e4e1c36ddf?w=800'} 
                      alt={item.name} 
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                    />
                  </a>
                  <span class="text-xs text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full font-medium inline-block mb-1.5 border border-emerald-100">
                    {item.category?.name || pageTitle}
                  </span>
                  <a href={`/products/${item.slug}`}>
                    <h3 class="font-bold text-slate-900 text-sm line-clamp-2 hover:text-emerald-700 transition">
                      {item.name}
                    </h3>
                  </a>
                  <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                    {item.description || 'Chất liệu cao cấp, độ bền vượt trội.'}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 flex items-baseline justify-between">
                  <div>
                    <span class="text-base font-bold text-amber-600">
                      {(item.sale_price > 0 ? item.sale_price : item.price).toLocaleString('vi-VN')} <span class="text-[10px] font-normal">VND</span>
                    </span>
                    {item.sale_price > 0 && (
                      <span class="text-xs text-slate-400 line-through block">
                        {item.price.toLocaleString('vi-VN')} VND
                      </span>
                    )}
                  </div>
                  <a 
                    href={`/products/${item.slug}`}
                    class="bg-emerald-800 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg transition font-medium"
                  >
                    Xem chi tiết
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}

      </main>

      <!-- ==================== MODAL NHẬP SẢN PHẨM MỚI ==================== -->
      <div id="add-product-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
          <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-100">
            <div>
              <h3 class="text-lg font-bold text-slate-900">Nhập Thông Tin Sản Phẩm Mới</h3>
              <p class="text-xs text-slate-500">Dữ liệu sẽ được lưu trực tiếp vào CSDL MySQL Backend</p>
            </div>
            <button id="close-modal-btn" class="text-slate-400 hover:text-slate-700 text-xl font-bold cursor-pointer">&times;</button>
          </div>

          <form id="add-product-form" class="space-y-4 text-xs">
            <div>
              <label class="block font-medium text-slate-700 mb-1">Tên sản phẩm *</label>
              <input 
                type="text" 
                id="prod-name" 
                required 
                placeholder="Ví dụ: Bàn Ăn Gỗ Sồi 6 Ghế Bắc Âu"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-medium text-slate-700 mb-1">Mã định danh (Slug) *</label>
                <input 
                  type="text" 
                  id="prod-slug" 
                  required 
                  placeholder="ban-an-go-soi-6-ghe"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                />
              </div>
              <div>
                <label class="block font-medium text-slate-700 mb-1">Loại sản phẩm (Type) *</label>
                <select 
                  id="prod-type" 
                  class="w-full px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                >
                  <option value="ban-an" selected>Bàn Ăn (ban-an)</option>
                  <option value="ban-ben">Bàn Bên (ban-ben)</option>
                  <option value="ban-nuoc">Bàn Nước (ban-nuoc)</option>
                  <option value="sofa-bang">Sofa Băng (sofa-bang)</option>
                  <option value="ghe-an">Ghế Ăn (ghe-an)</option>
                  <option value="tu-tivi">Tủ Tivi (tu-tivi)</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-medium text-slate-700 mb-1">Giá gốc (VND) *</label>
                <input 
                  type="number" 
                  id="prod-price" 
                  required 
                  placeholder="8900000"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                />
              </div>
              <div>
                <label class="block font-medium text-slate-700 mb-1">Giá khuyến mãi (VND)</label>
                <input 
                  type="number" 
                  id="prod-saleprice" 
                  placeholder="7500000"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                />
              </div>
            </div>

            <div>
              <label class="block font-medium text-slate-700 mb-1">Link hình ảnh (URL)</label>
              <input 
                type="url" 
                id="prod-image" 
                placeholder="https://images.unsplash.com/..."
                value="https://images.unsplash.com/photo-1615066390971-03e4e1c36ddf?w=800"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-medium text-slate-700 mb-1">Chất liệu</label>
                <input 
                  type="text" 
                  id="prod-material" 
                  placeholder="Gỗ sồi Nga tự nhiên"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                />
              </div>
              <div>
                <label class="block font-medium text-slate-700 mb-1">Kích thước</label>
                <input 
                  type="text" 
                  id="prod-dimensions" 
                  placeholder="180cm x 80cm x 75cm"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
                />
              </div>
            </div>

            <div>
              <label class="block font-medium text-slate-700 mb-1">Mô tả sản phẩm</label>
              <textarea 
                id="prod-description" 
                rows="2"
                placeholder="Mô tả tóm tắt đặc điểm nổi bật..."
                class="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs"
              ></textarea>
            </div>

            <div id="form-message" class="hidden text-xs py-2 px-3 rounded-xl font-medium"></div>

            <div class="flex justify-end space-x-3 pt-3 border-t border-slate-100">
              <button 
                type="button" 
                id="cancel-modal-btn"
                class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition font-medium"
              >
                Hủy
              </button>
              <button 
                type="submit" 
                id="submit-product-btn"
                class="bg-emerald-700 hover:bg-emerald-600 text-white px-5 py-2 rounded-xl font-semibold transition shadow-xs"
              >
                Lưu Sản Phẩm
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>

    <Footer />
  </body>
</html>

<script>
  function setupAddProduct() {
    const openBtn = document.getElementById('open-add-product-btn');
    const closeBtn = document.getElementById('close-modal-btn');
    const cancelBtn = document.getElementById('cancel-modal-btn');
    const modal = document.getElementById('add-product-modal');
    const form = document.getElementById('add-product-form') as HTMLFormElement;
    const nameInput = document.getElementById('prod-name') as HTMLInputElement;
    const slugInput = document.getElementById('prod-slug') as HTMLInputElement;
    const msgBox = document.getElementById('form-message');

    // Tự động tạo slug khi gõ tên
    nameInput?.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        const text = nameInput.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        slugInput.value = text.replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      }
    });

    slugInput?.addEventListener('input', () => {
      slugInput.dataset.manual = 'true';
    });

    function showModal() { modal?.classList.remove('hidden'); }
    function hideModal() { modal?.classList.add('hidden'); }

    openBtn?.addEventListener('click', showModal);
    closeBtn?.addEventListener('click', hideModal);
    cancelBtn?.addEventListener('click', hideModal);

    // Gửi dữ liệu tạo sản phẩm mới về Backend Golang
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-product-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.innerText = 'Đang lưu...';

      const payload = {
        name: (document.getElementById('prod-name') as HTMLInputElement).value,
        slug: (document.getElementById('prod-slug') as HTMLInputElement).value,
        type: (document.getElementById('prod-type') as HTMLSelectElement).value,
        price: parseFloat((document.getElementById('prod-price') as HTMLInputElement).value) || 0,
        sale_price: parseFloat((document.getElementById('prod-saleprice') as HTMLInputElement).value) || 0,
        image: (document.getElementById('prod-image') as HTMLInputElement).value,
        material: (document.getElementById('prod-material') as HTMLInputElement).value,
        dimensions: (document.getElementById('prod-dimensions') as HTMLInputElement).value,
        description: (document.getElementById('prod-description') as HTMLTextAreaElement).value,
        category_id: 2, // Category Bàn Ăn
        stock: 10
      };

      try {
        const res = await fetch('http://localhost:8080/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok) {
          if (msgBox) {
            msgBox.className = 'text-xs py-2 px-3 rounded-xl font-medium bg-emerald-100 text-emerald-800 block';
            msgBox.innerText = '✅ Thêm sản phẩm thành công! Đang tải lại trang...';
          }
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        } else {
          throw new Error(data.error || 'Có lỗi xảy ra');
        }
      } catch (err: any) {
        if (msgBox) {
          msgBox.className = 'text-xs py-2 px-3 rounded-xl font-medium bg-red-100 text-red-800 block';
          msgBox.innerText = '❌ ' + err.message;
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Lưu Sản Phẩm';
      }
    });
  }

  setupAddProduct();
  document.addEventListener('astro:page-load', setupAddProduct);
</script>
