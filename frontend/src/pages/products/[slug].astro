---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = false;

const { slug } = Astro.params;

let product = null;
try {
  const res = await fetch(`http://localhost:8080/api/products/${slug}`);
  if (res.ok) {
    product = await res.json();
  }
} catch (error) {
  console.error("Lỗi khi lấy chi tiết sản phẩm:", error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product ? product.name : 'Sản phẩm không tồn tại'} - NAMQUAN FURNITURE</title>
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">
    
    <div>
      <Header />

      <main class="max-w-6xl mx-auto px-4 py-10">
        <a href="/" class="text-sm font-medium text-slate-500 hover:text-emerald-800 mb-6 inline-flex items-center transition">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Quay lại trang chủ
        </a>

        {!product ? (
          <div class="bg-white rounded-2xl shadow-xs border border-slate-200 p-12 text-center">
            <h1 class="text-2xl font-bold text-red-600 mb-2">Sản phẩm không tồn tại</h1>
            <p class="text-slate-500 text-sm mb-6">Sản phẩm bạn đang tìm kiếm không tồn tại hoặc Server Backend API chưa hoạt động.</p>
            <a href="/" class="bg-emerald-800 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition inline-block">
              Quay lại trang chủ
            </a>
          </div>
        ) : (
          <div class="bg-white rounded-3xl shadow-xs border border-emerald-100 p-6 md:p-10 grid grid-cols-1 md:grid-cols-2 gap-10">
            <!-- Product Image -->
            <div class="rounded-2xl overflow-hidden bg-slate-50 border border-slate-100">
              <img src={product.image} alt={product.name} class="w-full h-[420px] object-cover" />
            </div>

            <!-- Product Info -->
            <div class="flex flex-col justify-between">
              <div>
                <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200/60">
                  {product.category?.name || 'Nội thất'}
                </span>
                <h1 class="text-3xl font-extrabold mt-3 text-slate-900 leading-tight">{product.name}</h1>
                
                <div class="mt-4 flex items-baseline space-x-3">
                  <span class="text-3xl font-bold text-amber-600">
                    {(product.sale_price > 0 ? product.sale_price : product.price).toLocaleString('vi-VN')} đ
                  </span>
                  {product.sale_price > 0 && (
                    <span class="text-sm text-slate-400 line-through">
                      {product.price.toLocaleString('vi-VN')} đ
                    </span>
                  )}
                </div>

                <div class="mt-6 space-y-2.5 border-t border-b border-slate-100 py-4 text-sm">
                  <p><strong class="text-slate-700 font-semibold">Chất liệu:</strong> {product.material || 'Đang cập nhật'}</p>
                  <p><strong class="text-slate-700 font-semibold">Kích thước:</strong> {product.dimensions || 'Đang cập nhật'}</p>
                  <p><strong class="text-slate-700 font-semibold">Tình trạng:</strong> {product.stock > 0 ? `Còn hàng (${product.stock} sản phẩm)` : 'Hết hàng'}</p>
                </div>

                <p class="mt-4 text-slate-600 text-sm leading-relaxed">{product.description}</p>
              </div>

              <div class="mt-8 flex gap-4">
                <button class="flex-1 bg-emerald-800 hover:bg-emerald-700 text-white py-3.5 rounded-xl font-semibold text-sm transition shadow-sm">
                  Thêm vào giỏ hàng
                </button>
                <button class="bg-amber-500 hover:bg-amber-600 text-white px-6 py-3.5 rounded-xl font-semibold text-sm transition shadow-sm">
                  Mua ngay
                </button>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>

    <Footer />
  </body>
</html>