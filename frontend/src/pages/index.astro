---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import BrandShowcase from '../components/BrandShowcase.astro';
import FlashSale from '../components/FlashSale.astro';
import Footer from '../components/Footer.astro';

// Fetch real products from Backend API
let products = [];
try {
  const res = await fetch('http://localhost:8080/api/products');
  if (res.ok) {
    products = await res.json();
  }
} catch (error) {
  console.error("Lỗi khi kết nối API Backend Golang:", error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NAMQUAN FURNITURE - Mỗi Không Gian Một Câu Chuyện Riêng</title>
  </head>
  <body class="bg-white text-slate-800 font-sans antialiased">
    <!-- Header -->
    <Header />

    <!-- Hero Section -->
    <Hero />

    <!-- Category Grid Showcase -->
    <CategoryGrid />

    <!-- Brand Showcase Section (Glassmorphism) -->
    <BrandShowcase />

    <!-- Flash Sale & Products Grid -->
    <FlashSale products={products} />

    <!-- Footer -->
    <Footer />
  </body>
</html>