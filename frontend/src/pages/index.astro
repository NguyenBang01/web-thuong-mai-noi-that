---
// Lấy dữ liệu sản phẩm từ Backend Golang API
let products = [];
try {
  const res = await fetch('http://localhost:8080/api/products');
  if (res.ok) {
    products = await res.json();
  }
} catch (error) {
  console.error("Lỗi gọi API Backend:", error);
}
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>NAMQUAN - Nội Thất Cao Cấp</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    
    <!-- Header / Navbar -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold tracking-wider text-amber-900">NAMQUAN FURNITURE</a>
        <nav class="space-x-6 text-sm font-medium">
          <a href="/" class="text-amber-800 hover:text-amber-600">Trang chủ</a>
          <a href="/gioi-thieu" class="hover:text-amber-800">Giới thiệu</a>
          <a href="#" class="hover:text-amber-800">Sản phẩm</a>
          <a href="#" class="hover:text-amber-800">Liên hệ</a>
        </nav>
      </div>
    </header>

    <!-- Banner -->
    <section class="bg-amber-900 text-white py-16 text-center">
      <h2 class="text-4xl font-light mb-3">Kiến Tạo Không Gian Sống Đẳng Cấp</h2>
      <p class="text-amber-200 text-sm">Thiết kế tối giản, chất liệu cao cấp theo phong cách NAMQUAN</p>
    </section>

    <!-- Main Content: Product Grid -->
    <main class="max-w-7xl mx-auto px-4 py-12">
      <h3 class="text-2xl font-semibold mb-8 text-center uppercase tracking-wide">Sản Phẩm Nổi Bật</h3>

      {products.length === 0 ? (
        <div class="text-center py-8">
          <p class="text-gray-500">Chưa có sản phẩm nào hoặc Backend chưa khởi chạy.</p>
          <p class="text-xs text-gray-400 mt-2">Hãy kiểm tra `go run main.go` và chạy lệnh nạp dữ liệu sample `api/seed`.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {products.map((item) => (
            <div class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300 border border-gray-100 flex flex-col">
              <a href={`/products/${item.slug}`} class="block overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-64 object-cover hover:scale-105 transition-transform duration-300"
                />
              </a>
              <div class="p-4 flex flex-col flex-grow justify-between">
                <div>
                  <span class="text-xs text-amber-700 bg-amber-50 px-2 py-1 rounded">
                    {item.category?.name || 'Nội thất'}
                  </span>
                  <a href={`/products/${item.slug}`}>
                    <h4 class="font-medium text-lg mt-2 text-gray-900 line-clamp-1 hover:text-amber-800">{item.name}</h4>
                  </a>
                  <p class="text-xs text-gray-500 mt-1 line-clamp-2">{item.description}</p>
                </div>
                
                <div class="mt-4 pt-3 border-t flex justify-between items-center">
                  <div>
                    <span class="text-lg font-bold text-amber-900">
                      {item.sale_price > 0 ? item.sale_price.toLocaleString('vi-VN') : item.price.toLocaleString('vi-VN')} đ
                    </span>
                    {item.sale_price > 0 && (
                      <span class="text-xs text-gray-400 line-through block">
                        {item.price.toLocaleString('vi-VN')} đ
                      </span>
                    )}
                  </div>
                  <!-- Đã chuyển sang thẻ <a> để chuyển hướng trang chi tiết -->
                  <a 
                    href={`/products/${item.slug}`} 
                    class="bg-amber-900 hover:bg-amber-800 text-white text-xs px-3 py-2 rounded inline-block transition"
                  >
                    Xem chi tiết
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </main>

  </body>
</html>